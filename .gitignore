.cache/

# Internal roadmap assessment working dir — keep the Mural export and the derived
# analysis OUT of the public GitHub Pages site (scripts/build-docs.mjs publishes docs/).
# Leading slash anchors this to the repo root so it does NOT also ignore the
# checked-in skill at .claude/skills/roadmap-assessment/.
/roadmap-assessment/

# Secrets — never commit
.env
.env.*
!.env.example

# Perf-mode working dir: generated dev keypair, JWKS, backend env, JMeter output.
# Local-only, never committed (the private key is regenerated on demand).
/.perf/

# Private keys / certs
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.kdbx

# Generated by scripts/build-docs.mjs and the Pages workflow
site_src/
_site/
mkdocs.generated.yml

# Rules-engine explainer working state — intermediates, not deliverables
/.rules-engine-explainer/

# GeoPackage validation explainer working state — intermediates, not deliverables
/.geopackage-validation-explainer/

# npm run compare:metric output
/metric-comparison/

# The QGIS template moved to the bng-metric-template sibling repo (reached via
# the `template` symlink). An old checkout may still hold its generated sites
# and plugin builds here; they are local leftovers, safe to delete.
/qgis-template/
