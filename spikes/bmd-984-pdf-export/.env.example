# Copy to `.env` and fill in. `.env` is gitignored by the harness root
# .gitignore; `.env.example` is committed and must never hold a real value.
#
# A real environment variable overrides anything here, so a one-off
# `OS_MAPS_MAX_ZOOM=13 node src/cli.mjs --os` works without editing the file.

# One key serves both basemap routes, but each route needs its OWN product
# added to the key's OS Data Hub API Project — a missing product 401s with no
# diagnostic:
#   --os-vector (npm run osdemo)         needs "OS NGD API – Tiles"
#   --os        (npm run osdemo:raster)  needs "OS Maps API"
OS_MAPS_API_KEY=

# RASTER ROUTE ONLY: the zoom ceiling of the *plan*, not the product.
#   OpenData plan : 9   (EPSG:27700 tops out at 1.75 m/px; z10+ returns 403
#                        "A Premium Plan is required to access Premium Data")
#   Premium / PSGA: leave unset to use the full z0-13
# The vector route has shown no plan ceiling — z0-15 all serve.
OS_MAPS_MAX_ZOOM=9

# Optional, raster route only. Light_27700 (default), Road_27700,
# Outdoor_27700, Leisure_27700.
# OS_MAPS_LAYER=Light_27700
