# Spike-only override. The harness and siblings set `min-release-age=7` as
# supply-chain hardening. pdfkit 0.20.1 (2026-08-23) is newer than that window
# but is the first release with a real Node ESM build — without it, `import
# 'pdfkit'` resolves to the browser bundle. This directory is a throwaway spike
# and ships nothing, so the window is relaxed here and here only.
min-release-age=0
ignore-scripts=true
save-exact=true
audit=false
fund=false
