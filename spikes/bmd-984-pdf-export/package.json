{
  "name": "bmd-984-pdf-export-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BMD-984 spike: accessible PDF export with an OS basemap and vector habitat overlays",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/cli.mjs",
    "osdemo": "node src/cli.mjs --os-vector && node src/verify-pdf.mjs",
    "osdemo:raster": "node src/cli.mjs --os && node src/verify-pdf.mjs",
    "verify": "node src/verify-pdf.mjs",
    "extract:style": "node tools/extract-ngd-style.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "serve:tiles": "node src/os-proxy/server.mjs"
  },
  "dependencies": {
    "pdfkit": "0.20.1"
  },
  "devDependencies": {
    "@hapi/hapi": "21.4.10"
  }
}
